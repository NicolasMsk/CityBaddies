# Dockerfile pour Cloud Run Job - Competitor Marionnaud (Playwright + GPT)
FROM mcr.microsoft.com/playwright:v1.57.0-jammy

WORKDIR /app

COPY package*.json ./
COPY prisma ./prisma/
COPY tsconfig.json ./

RUN npm ci
RUN npm install -g tsx

RUN npx prisma generate

COPY src/lib ./src/lib/
COPY src/scripts/cloud-jobs/competitor-marionnaud.ts ./src/scripts/cloud-jobs/

ENV NODE_ENV=production

CMD ["npx", "tsx", "src/scripts/cloud-jobs/competitor-marionnaud.ts"]
