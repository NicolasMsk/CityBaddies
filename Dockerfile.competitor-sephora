# Dockerfile pour Cloud Run Job - Competitor Sephora (Playwright + GPT)
FROM mcr.microsoft.com/playwright:v1.57.0-jammy

WORKDIR /app

# Copier les fichiers de dépendances
COPY package*.json ./
COPY prisma ./prisma/
COPY tsconfig.json ./

# Installer les dépendances
RUN npm ci
RUN npm install -g tsx

# Générer le client Prisma
RUN npx prisma generate

# Copier le code source nécessaire (lib scraping + cloud job)
COPY src/lib ./src/lib/
COPY src/scripts/cloud-jobs/competitor-sephora.ts ./src/scripts/cloud-jobs/

# Variables d'environnement (seront override par Cloud Run)
ENV NODE_ENV=production

# Commande d'exécution
CMD ["npx", "tsx", "src/scripts/cloud-jobs/competitor-sephora.ts"]
