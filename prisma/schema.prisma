// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Statut d'un deal dans le workflow Import → Validate → Enrich
enum DealStatus {
  PENDING
  ACTIVE
  EXPIRED
}

// Utilisateurs (synchronisés avec Supabase Auth)
model User {
  id            String     @id // UUID from Supabase Auth
  email         String     @unique
  username      String?    @unique
  displayName   String?
  avatarUrl     String?
  bio           String?
  isAdmin       Boolean    @default(false)
  reputation    Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  // Relations
  favorites       Favorite[]
  votes           Vote[]
  comments        Comment[]
  postedDeals     Deal[]           @relation("DealAuthor")
  promoCodes      PromoCode[]      @relation("PromoCodeAuthor")
  promoCodeVotes  PromoCodeVote[]
  
  @@index([email])
  @@index([username])
}

// Favoris des utilisateurs
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, dealId])
  @@index([userId])
  @@index([dealId])
}

// Votes sur les deals (like Dealabs)
model Vote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  value     Int      // +1 ou -1
  createdAt DateTime @default(now())

  @@unique([userId, dealId])
  @@index([userId])
  @@index([dealId])
}

// Commentaires sur les deals
model Comment {
  id        String    @id @default(cuid())
  content   String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealId    String
  deal      Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([dealId])
  @@index([parentId])
}

// Catégories de produits beauté
model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  icon        String?
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Marchands/Sites e-commerce
model Merchant {
  id               String            @id @default(cuid())
  name             String            @unique
  slug             String            @unique
  logoUrl          String?
  website          String
  deals            Deal[]
  scrapingSources  ScrapingSource[]
  promoCodes       PromoCode[]       @relation("MerchantPromoCodes")
  promoPage        MerchantPromoPage?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// Marques de produits beauté (normalisées)
model Brand {
  id             String    @id @default(cuid())
  name           String    @unique  // Nom normalisé (ex: "Chanel")
  slug           String    @unique  // slug (ex: "chanel")
  logoUrl        String?            // Logo de la marque
  description    String?            // Description courte de la marque
  seoDescription String?   @db.Text // Description longue SEO (histoire, valeurs, produits phares)
  aliases        String?            // Variantes séparées par virgules (ex: "YSL,Yves St Laurent")
  tier           Int       @default(2) // 1=Luxe, 2=Milieu de gamme, 3=Entrée de gamme
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Produits beauté (fiche produit immuable)
model Product {
  id                   String            @id @default(cuid())
  name                 String
  slug                 String            @unique
  description          String?           // Description simple (marque - nom)
  seoDescription       String?  @db.Text // Description longue SEO (bénéfices, ingrédients clés, conseils)
  availableSizes       String?           // Contenances disponibles (ex: "30ml,50ml,100ml")
  imageUrl             String?
  brand                String?           // Ancien champ texte (sera migré vers brandId)
  brandId              String?           // Relation vers Brand (nouveau)
  brandRef             Brand?            @relation(fields: [brandId], references: [id])
  categoryId           String
  category             Category          @relation(fields: [categoryId], references: [id])
  subcategory          String?           // Sous-catégorie (ex: "levres", "shampoings", etc.)
  subsubcategory       String?           // Sous-sous-catégorie (ex: "rouge-a-levres", "shampoing-hydratant")
  isActive             Boolean           @default(true)
  
  // Données enrichies (scraping)
  ingredients          String?  @db.Text // Liste INCI des ingrédients
  application          String?  @db.Text // Conseils d'utilisation
  labels               String?           // Labels séparés par virgules (sans silicone, vegan, etc.)
  classifications      Json?             // Classifications produit (Parfum, Texture, Type de cheveux, etc.)
  
  // Relations
  variants             ProductVariant[]
  images               ProductImage[]
  priceHistory         PriceHistory[]
  deals                Deal[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  // Index simples
  @@index([categoryId])
  @@index([brandId])
  @@index([subcategory])
  @@index([subsubcategory])
  
  // Index composites pour requêtes fréquentes
  @@index([brandId, categoryId])           // Produits d'une marque dans une catégorie
  @@index([isActive, categoryId])          // Produits actifs d'une catégorie
}

// Images produit (multiples images par produit: packshot, lifestyle, swatch, etc.)
model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  alt         String?
  type        String   @default("unknown")  // packshot, lifestyle, detail, swatch, unknown
  position    Int      @default(0)
  width       Int?
  height      Int?
  merchantId  String?                       // D'où vient cette image
  createdAt   DateTime @default(now())

  @@unique([productId, url])
  @@index([productId])
  @@index([productId, position])
  @@index([type])
}

// Variantes de produit (différentes contenances: 50ml, 100ml, etc.)
model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  volumeValue   Float    // Valeur numérique (ex: 50, 100, 200)
  volumeUnit    String   // Unité normalisée: "ml", "g", "l", "kg"
  volumeRaw     String?  // Volume brut original (ex: "50 ML", "1.7 oz") pour debug
  ean           String?  // Code-barres EAN spécifique à la variante
  
  deals         Deal[]        // Les deals sont liés à une variante spécifique
  priceHistory  PriceHistory[] // Historique des prix pour cette variante
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([productId, volumeValue, volumeUnit]) // Une seule variante par produit+volume
  @@index([productId])
  @@index([ean])
  @@index([volumeValue, volumeUnit])  // Pour trouver toutes les variantes 50ml
}

// Historique des prix pour chaque produit (avec contenance)
model PriceHistory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price       Float
  
  // Contenance associée au prix (essentiel pour comparer les prix)
  variantId   String?              // Lien vers la variante (si connue)
  variant     ProductVariant?      @relation(fields: [variantId], references: [id])
  volumeValue Float?               // Valeur numérique (ex: 50, 100)
  volumeUnit  String?              // Unité: "ml", "g", "l", "kg"
  volumeRaw   String?              // Volume brut original (ex: "50 ML")
  
  date        DateTime @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([date])
  @@index([productId, volumeValue, volumeUnit])  // Pour filtrer par produit+contenance
}

// Deals/Promotions (offres éphémères)
model Deal {
  id              String     @id @default(cuid())
  productId       String
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // Variante du produit (50ml, 100ml, etc.) - optionnel pour migration progressive
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  
  // Marchand et URLs
  merchantId      String
  merchant        Merchant   @relation(fields: [merchantId], references: [id])
  imageUrl        String?    // Image du produit chez ce marchand
  productUrl      String?    // URL du produit chez ce marchand
  
  title           String
  refinedTitle    String?    // Titre optimisé par IA (ex: "L'Oréal Pro - Crème Hydratante Curl (200ml)")
  description     String?
  whyGoodDeal     String?    @db.Text // Explication SEO: pourquoi c'est un bon deal (généré par IA)
  type            String     @default("scraped") // "scraped", "manual", "promo_code"
  dealPrice       Float
  originalPrice   Float
  discountPercent Int
  discountAmount  Float
  promoCode       String?
  priceConditions  String?    @db.Text // Conditions du prix (ex: "Prix avec la carte fidélité", "Offre valable du 01/02 au 28/02")
  
  // Traçabilité du scraping
  sourceUrl       String?    // URL de la page source qui a permis de scraper ce deal (pour debug)
  
  // Volume (gardé temporairement pour migration, sera supprimé quand variantId obligatoire)
  volume          String?    // @deprecated - utiliser variant.volumeRaw
  volumeValue     Float?     // @deprecated - utiliser variant.volumeValue  
  volumeUnit      String?    // @deprecated - utiliser variant.volumeUnit
  
  pricePerUnit    Float?     // Prix par unité (€/ml ou €/g) - calculé depuis dealPrice / variant.volumeValue
  brandTier       Int        @default(2) // Notoriété marque: 1=connue (Chanel, Dior), 2=moyenne, 3=inconnue
  score           Float      @default(0) // Score global du deal (0-100)
  tags            String?    // Tags séparés par virgules (ex: "LUXE,TENDANCE,TOP_DEAL")
  startDate       DateTime   @default(now())
  endDate         DateTime?
  isHot           Boolean    @default(false) // Validé par la communauté (votes >= 20)
  status          DealStatus @default(PENDING) // Statut du deal dans le workflow
  isTrending      Boolean    @default(false) // Produit tendance réseaux sociaux
  lastSeenAt      DateTime   @default(now()) // Dernière fois que le deal a été vu en scraping
  votes           Int        @default(0)
  views           Int        @default(0)
  
  // Auteur du deal (optionnel pour les deals scrapés)
  authorId        String?
  author          User?      @relation("DealAuthor", fields: [authorId], references: [id])
  
  // Relations
  favorites           Favorite[]
  voteRecords         Vote[]
  comments            Comment[]
  buyingGuideProducts BuyingGuideProduct[]   // Apparitions dans les guides d'achat
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Index simples
  @@index([productId])
  @@index([variantId])
  @@index([merchantId])
  @@index([status])
  @@index([isHot])
  @@index([brandTier])
  @@index([pricePerUnit])
  @@index([score])
  @@index([type])
  @@index([createdAt])
  @@index([authorId])
  @@index([lastSeenAt])                    // Pour le job d'expiration
  
  // Index composites pour requêtes fréquentes
  @@index([status, score])                 // Deals par statut triés par score
  @@index([status, brandTier, score])      // Deals par statut et tier de marque
  @@index([status, pricePerUnit])          // Deals par statut triés par prix/unité
  @@index([productId, status])             // Deals d'un produit par statut
  @@index([status, lastSeenAt])            // Deals par statut et dernière vue
  @@unique([variantId, merchantId])        // Un seul deal par variante+marchand (upsert scraping)
}

// Alertes de prix pour les utilisateurs
model PriceAlert {
  id          String   @id @default(cuid())
  email       String
  productSlug String
  targetPrice Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([productSlug])
}

// Sources de scraping (URLs à scraper pour chaque marchand)
model ScrapingSource {
  id          String   @id @default(cuid())
  merchantId  String
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  url         String   @unique
  name        String   // Nom descriptif (ex: "Promos Maquillage", "Tendances réseaux sociaux")
  category    String   // Catégorie cible (ex: "maquillage", "parfums")
  type        String   @default("promo") // "promo", "trending", "nouveautes", etc.
  isActive    Boolean  @default(true)
  priority    Int      @default(0) // Pour ordonner les sources (plus élevé = priorité)
  maxProducts Int      @default(50) // Nombre max de produits à scraper
  lastScraped DateTime? // Date du dernier scraping
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantId])
  @@index([isActive])
  @@index([type])
}



// ============================================================================
// GUIDES D'ACHAT (générés automatiquement par IA)
// ============================================================================

enum GuideStatus {
  DRAFT      // Brouillon en cours de génération
  PUBLISHED  // Publié et visible sur le site
  ARCHIVED   // Archivé (ancien guide remplacé)
}

// Guide d'achat complet (généré quotidiennement par GPT)
model BuyingGuide {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String      // Titre principal du guide
  metaTitle       String?     // Titre SEO (<60 chars)
  metaDescription String?     // Description SEO (<155 chars)
  heroImageUrl    String?     // Image principale (celle du meilleur deal)
  introduction    String      @db.Text // Introduction accrocheuse (style City Baddies)
  content         String      @db.Text // Contenu principal en HTML structuré
  conclusion      String?     @db.Text // Conclusion avec CTA
  faq             Json?       // FAQ structurée [{question, answer}] pour schema.org
  criteria        Json?       // Critères de sélection ["Texture et absorption", "Rapport qualité/prix", ...]
  
  // Classification
  category        String      // Catégorie principale (maquillage, skincare, etc.)
  tags            String?     // Tags séparés par virgules (ex: "luxe,skincare,hiver")
  season          String?     // Saison ciblée (printemps, été, automne, hiver, all)
  targetKeywords  String?     @db.Text // Mots-clés SEO ciblés séparés par virgules
  
  // Statut & publication
  status          GuideStatus @default(DRAFT)
  publishedAt     DateTime?
  
  // Relations
  products        BuyingGuideProduct[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([category])
  @@index([publishedAt])
  @@index([status, publishedAt])
  @@index([slug])
}

// Produit recommandé dans un guide d'achat
model BuyingGuideProduct {
  id          String      @id @default(cuid())
  guideId     String
  guide       BuyingGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  dealId      String
  deal        Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  
  rank        Int         // Position dans le classement (1 = meilleur pick)
  badge       String?     // Badge spécial (ex: "Le Choix Baddie", "Best Value", "Luxe Abordable")
  miniReview  String      @db.Text // Mini-review du produit dans le contexte du guide
  pros        String?     // Avantages séparés par | (ex: "Longue tenue|Pigmenté|Bon rapport qualité-prix")
  cons        String?     // Inconvénients séparés par | (ex: "Packaging basique|Peu de teintes")
  verdict     String?     // Verdict court (1-2 phrases)
  rating      Float?      // Note sur 5 attribuée par la rédaction (ex: 4.5)
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([guideId, dealId])
  @@unique([guideId, rank])
  @@index([guideId])
  @@index([dealId])
}

// ============================================================================
// PAGE CODE PROMO MARCHAND (contenu riche SEO par marchand)
// ============================================================================

// Page landing "/codes-promo/sephora" — contenu éditorial riche généré par IA
model MerchantPromoPage {
  id                  String   @id @default(cuid())
  merchantId          String   @unique
  merchant            Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  
  // SEO
  metaTitle           String?          // Ex: "Codes promo Sephora — Février 2026 | City Baddies"
  metaDescription     String?          // Ex: "Découvrez tous les codes promo Sephora valides…" (<155 chars)
  canonicalSlug       String   @unique // Ex: "sephora" → /codes-promo/sephora
  
  // Contenu éditorial principal
  heroTitle           String?          // Titre H1 (ex: "Codes promo Sephora — Février 2026")
  heroSubtitle        String?          // Sous-titre accrocheur
  introduction        String?  @db.Text // Paragraphe d'intro SEO (contexte, saison, événements en cours)
  
  // Description du marchand (contexte code promo)
  merchantDescription String?  @db.Text // Présentation du marchand orientée promo (histoire, positionnement, marques phares)
  merchantAdvantages  Json?            // Avantages clés [{icon, title, text}] ex: "Livraison offerte dès 60€", "Programme fidélité"
  shippingInfo        String?  @db.Text // Infos livraison (seuils, délais, click & collect)
  returnPolicy        String?          // Politique retour résumée
  loyaltyProgram      String?  @db.Text // Description programme fidélité si existant
  
  // Guide "Comment utiliser un code promo"
  howToUse            Json?            // Étapes [{step, title, description, imageUrl?}] — tutoriel pas à pas
  howToUseHtml        String?  @db.Text // Version HTML rendue du tutoriel (pour SSR)
  
  // Astuces & conseils
  tips                Json?            // Conseils [{title, content}] ex: "Cumulez avec les soldes", "Inscrivez-vous à la newsletter"
  bestTimeToShop      String?  @db.Text // Meilleurs moments pour acheter (soldes, Black Friday, ventes privées)
  
  // FAQ structurée (schema.org FAQPage)
  faq                 Json?            // [{question, answer}] ex: "Les codes promo Sephora sont-ils cumulables ?"
  
  // Statistiques affichées sur la page
  averageDiscount     Float?           // Réduction moyenne constatée (ex: 15.5 pour 15,5%)
  totalActiveOffers   Int      @default(0) // Nombre d'offres actives (mis à jour automatiquement)
  bestCurrentDiscount Float?           // Meilleure réduction en cours (ex: 30 pour -30%)
  lastVerifiedAt      DateTime?        // Date dernière vérification des codes
  
  // Contenu additionnel
  conclusion          String?  @db.Text // Paragraphe de conclusion avec CTA
  relatedMerchants    String?          // Slugs marchands similaires séparés par virgules (ex: "nocibe,marionnaud")
  targetKeywords      String?  @db.Text // Mots-clés SEO ciblés (ex: "code promo sephora, réduction sephora, bon de réduction")
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([canonicalSlug])
  @@index([merchantId])
}

// ============================================================================
// CODES PROMO (agrégés depuis les marchands beauté)
// ============================================================================

enum PromoCodeStatus {
  ACTIVE     // Code actif et vérifié
  EXPIRED    // Code expiré
  UNVERIFIED // Pas encore vérifié (soumis par la communauté)
}

enum DiscountType {
  PERCENTAGE      // Ex: -20%
  FIXED_AMOUNT    // Ex: -10€
  FREE_SHIPPING   // Livraison gratuite
  GIFT            // Cadeau offert (ex: "trousse offerte dès 50€")
  CASHBACK        // Remboursement (ex: "10€ remboursés")
}

// Code promo valable chez un marchand
model PromoCode {
  id                String          @id @default(cuid())
  code              String          // Le code promo (ex: "BEAUTY20", "SEPHORA10")
  slug              String          @unique // Slug unique pour l'URL (ex: "sephora-beauty20-fevrier-2026")
  title             String          // Titre accrocheur (ex: "-20% sur tout le site Sephora")
  description       String?         @db.Text // Description détaillée des conditions
  
  // Marchand associé
  merchantId        String
  merchant          Merchant        @relation("MerchantPromoCodes", fields: [merchantId], references: [id])
  
  // Type et valeur de la réduction
  discountType      DiscountType    @default(PERCENTAGE)
  discountValue     Float?          // Valeur numérique (20 pour 20%, 10 pour 10€) — null si GIFT
  
  // Conditions d'utilisation
  minimumPurchase   Float?          // Montant minimum de commande (ex: 50€)
  maximumDiscount   Float?          // Plafond de réduction (ex: "20% max 30€")
  applicableTo      String?         // Catégories/marques concernées (ex: "parfums", "tout le site", "marque Dior")
  conditions        String?         @db.Text // Conditions textuelles libres (ex: "Hors coffrets, 1 utilisation par client")
  isNewCustomerOnly Boolean         @default(false) // Réservé aux nouveaux clients
  isStackable       Boolean         @default(false) // Cumulable avec d'autres promos
  
  // Validité
  status            PromoCodeStatus @default(UNVERIFIED)
  startDate         DateTime        @default(now())
  expiresAt         DateTime?       // Null = pas de date d'expiration connue
  
  // Engagement communautaire
  isVerified        Boolean         @default(false) // Vérifié par l'équipe ou la communauté
  isExclusive       Boolean         @default(false) // Exclusif City Baddies
  isFeatured        Boolean         @default(false) // Mis en avant sur la homepage
  successRate       Int?            // % de réussite rapporté par les utilisateurs (0-100)
  usesCount         Int             @default(0) // Nombre de fois utilisé (clics)
  views             Int             @default(0) // Nombre de vues
  votes             Int             @default(0) // Score de votes communautaires
  
  // Traçabilité
  sourceUrl         String?         // Où on a trouvé ce code (newsletter, site, influenceur)
  sourceType        String?         // "scraping", "newsletter", "influencer", "community", "official"
  
  // Auteur (si soumis par un utilisateur)
  authorId          String?
  author            User?           @relation("PromoCodeAuthor", fields: [authorId], references: [id])
  
  // Relations
  voteRecords       PromoCodeVote[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([code, merchantId]) // Un même code ne peut pas exister 2 fois pour le même marchand
  @@index([merchantId])
  @@index([status])
  @@index([status, expiresAt])
  @@index([merchantId, status])
  @@index([isVerified])
  @@index([isFeatured])
  @@index([discountType])
  @@index([votes])
  @@index([createdAt])
  @@index([authorId])
  @@index([slug])
}

// Votes sur les codes promo (le code marche / ne marche pas)
model PromoCodeVote {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  value       Int       // +1 = ça marche, -1 = ça ne marche pas
  comment     String?   // Commentaire optionnel (ex: "marche avec 50€ minimum")
  createdAt   DateTime  @default(now())

  @@unique([userId, promoCodeId])
  @@index([userId])
  @@index([promoCodeId])
}

// Abonnements newsletter
model NewsletterSubscription {
  id            String    @id @default(cuid())
  email         String    @unique
  firstName     String?
  isConfirmed   Boolean   @default(false)
  confirmToken  String?   @unique
  subscribedAt  DateTime  @default(now())
  confirmedAt   DateTime?
  unsubscribedAt DateTime?
  source        String    @default("website") // "signup", "homepage", "popup"
  
  @@index([email])
  @@index([confirmToken])
}

// ============================================================================
// SCRAPING QUEUE (alimentée par Product_Scraper_Link, consommée par Product_Scraper)
// ============================================================================

model ScrapingQueue {
  id           String    @id @default(cuid())
  productName  String
  merchantSlug String
  productUrl   String
  searchUrl    String
  verified     Boolean   @default(false)
  confidence   Float     @default(0)
  method       String    @default("")
  status       String    @default("pending") // "pending" | "scraping" | "done" | "failed" | "mismatch"

  // ── Résultats du scraping ──────────────────────────────────────────────────
  scrapedAt       DateTime?
  productId       String?           // ID du produit créé/matché en DB
  completeness    Int?              // % de complétude (0-100)
  verdict         String?           // "ok" | "wrong_product" | "aberrant_price" | "empty_data"
  verdictReason   String?           // Explication du verdict
  verdictConfidence Int?            // Confiance du verdict (0-100)
  missingFields   String?           // Champs manquants séparés par virgule (ex: "ingredients,usage")
  variantsFound   Int?              // Nombre de variantes trouvées
  variantsPushed  Int?              // Nombre de variantes effectivement pushées (après retrait aberrants)
  dealsPushed     Int?              // Nombre de deals créés
  priceFixes      String?           // Variantes retirées (ex: "10ml=299€,25g=0€")
  matchMethod     String?           // "exact_slug" | "llm_match" | "new_product"
  durationMs      Int?              // Durée totale du scraping en ms
  errorMessage    String?           // Message d'erreur si failed
  retryCount      Int     @default(0) // Nombre de tentatives

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([productName, merchantSlug])
  @@index([status])
  @@index([merchantSlug])
  @@index([productId])
  @@index([verdict])
  @@index([completeness])
}
